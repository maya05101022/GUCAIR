# GUCAIR local environment example.
# Copy this file to .env for local development and fill in real values.
# Never commit .env to version control.

DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Leave DATABASE_URL unset locally to use SQLite (db.sqlite3).
# In production set the Neon PostgreSQL connection string, including sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional administrator bootstrap used by `python manage.py create_admin`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Set to True during a Render build to seed clearly-labelled demo institutions.
SEED_DEMO=False
